PORT=3001
# Atlas → Connect → Drivers. Contains your password: keep it in .env only.
MONGODB_URI=
# Tests always use HT2_DB_test and HT2_DB_test_accounts, never this one.
MONGODB_DB=HT2_DB
# Signs the sign-in cookie. Required when deployed (NODE_ENV=production): a long
# random value, e.g. from `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`.
# Left empty in development, a new one is made each start (restarting signs everyone out).
SESSION_SECRET=
