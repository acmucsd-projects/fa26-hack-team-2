{
  "$jsonSchema": {
    "bsonType": "object",
    "description": "Stores standardized food and beverage records with their nutritional information",
    "required": [
      "version",
      "name",
      "personal",
      "beverage",
      "vegetarian",
      "wellness",
      "ingredients",
      "allergens",
      "nutrition"
    ],
    "properties": {
      "version": {
        "bsonType": "number",
        "multipleOf": 1,
        "minimum": 1,
        "description": "tracks which version of this collection this document is from"
      },
      "name": {
        "bsonType": "string",
        "description": "the name of the food or beverage"
      },
      "personal": {
        "bsonType": "bool",
        "description": "whether this food was self reported or comes from HDH"
      },
      "beverage": {
        "bsonType": "bool",
        "description": "whether this food is actually a drink"
      },
      "wellness": {
        "bsonType": [
          "bool",
          "null"
        ],
        "description": "Whether the food meets the HDH wellness criteria, if null then we don't know if it meets the criteria."
      },
      "vegetarian": {
        "bsonType": [
          "bool",
          "null"
        ],
        "description": "Whether the food is vegetarian. If null then we don't know if it's vegetarian."
      },
      "vegan": {
        "bsonType": [
          "bool",
          "null"
        ],
        "description": "Whether the food is vegan. If null then we don't know if it's vegan."
      },
      "sustainability": {
        "bsonType": [
          "bool",
          "null"
        ],
        "description": "Whether the food meets the HDH sustainability criteria, if null then we don't know if it meets the criteria."
      },
      "ingredients": {
        "bsonType": "array",
        "description": "A list of all ingredients",
        "items": {
          "bsonType": "string"
        }
      },
      "allergens": {
        "bsonType": "object",
        "description": "Contains the status for each possible allergen of the food. If this object is empty then we don't know if there are allergens.",
        "properties": {
          "eggs": {
            "bsonType": "bool",
            "description": "whether the food contains eggs"
          },
          "gluten": {
            "bsonType": "bool",
            "description": "whether the food contains gluten"
          },
          "tree_nuts": {
            "bsonType": "bool",
            "description": "whether the food contains tree nuts"
          },
          "fish": {
            "bsonType": "bool",
            "description": "whether the food contains fish"
          },
          "wheat": {
            "bsonType": "bool",
            "description": "whether the food contains wheat"
          },
          "sesame": {
            "bsonType": "bool",
            "description": "whether the food contains sesame"
          },
          "soy": {
            "bsonType": "bool",
            "description": "whether the food contains soy"
          },
          "peanuts": {
            "bsonType": "bool",
            "description": "whether the food contains peanuts"
          },
          "dairy": {
            "bsonType": "bool",
            "description": "whether the food contains dairy"
          },
          "shell_fish": {
            "bsonType": "bool",
            "description": "whether the food contains shell fish"
          }
        }
      },
      "nutrition": {
        "bsonType": "object",
        "description": "contains all nutrition data for this food",
        "required": [
          "macros"
        ],
        "properties": {
          "sodium": {
            "bsonType": "number",
            "description": "the total sodium in milligrams",
            "multipleOf": 1,
            "minimum": 0
          },
          "macros": {
            "bsonType": "object",
            "description": "contains the values for the amount of each macro-nutrient the food has",
            "properties": {
              "carb": {
                "bsonType": "number",
                "description": "the amount of carbs (milligrams) the food has",
                "multipleOf": 1,
                "minimum": 0
              },
              "protein": {
                "bsonType": "number",
                "description": "the amount of protein (milligrams) the food has",
                "multipleOf": 1,
                "minimum": 0
              },
              "fat": {
                "bsonType": "number",
                "description": "the amount of fat (milligrams) the food has",
                "multipleOf": 1,
                "minimum": 0
              }
            }
          },
          "sat_fat": {
            "bsonType": "number",
            "description": "the total saturated fat in milligrams",
            "multipleOf": 1,
            "minimum": 0
          },
          "fiber": {
            "bsonType": "number",
            "description": "the amount of fiber in milligrams",
            "multipleOf": 1,
            "minimum": 0
          },
          "serving_size": {
            "bsonType": "number",
            "description": "The serving size (tenths of oz) of the food",
            "multipleOf": 1,
            "minimum": 0
          },
          "calorie": {
            "bsonType": "number",
            "description": "the number of calories (in tenths of a calorie) the food has",
            "multipleOf": 1,
            "minimum": 0
          },
          "fat_cal": {
            "bsonType": "number",
            "description": "the calories that come from fat, in tenths of a calorie",
            "multipleOf": 1,
            "minimum": 0
          },
          "trans_fat": {
            "bsonType": "number",
            "description": "the total trans fat in milligrams",
            "multipleOf": 1,
            "minimum": 0
          },
          "cholesterol": {
            "bsonType": "number",
            "description": "the total cholesterol in milligrams",
            "multipleOf": 1,
            "minimum": 0
          },
          "sugar": {
            "bsonType": "number",
            "description": "the total sugar in milligrams",
            "multipleOf": 1,
            "minimum": 0
          }
        }
      }
    }
  }
}
